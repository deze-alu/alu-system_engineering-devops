#!/usr/bin/env bash
# Configure nginx like web-01 and add an X-Served-By header set to the server's hostname
apt-get update -y
apt-get install -y nginx

echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html

if ! grep -q "location /redirect_me" /etc/nginx/sites-available/default; then
    sed -i 's|server_name _;|server_name _;\n\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}|' /etc/nginx/sites-available/default
fi

if ! grep -q "error_page 404" /etc/nginx/sites-available/default; then
    sed -i 's|server_name _;|server_name _;\n\n\terror_page 404 /404.html;\n\tlocation = /404.html {\n\t\tinternal;\n\t}|' /etc/nginx/sites-available/default
fi

if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
    # $hostname is an nginx variable and must reach the config unexpanded
    # shellcheck disable=SC2016
    sed -i 's|server_name _;|server_name _;\n\n\tadd_header X-Served-By $hostname;|' /etc/nginx/sites-available/default
fi

service nginx restart
