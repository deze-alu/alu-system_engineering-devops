#!/usr/bin/env bash
# Install ufw and block all incoming traffic except TCP ports 22 (SSH), 443 (HTTPS) and 80 (HTTP)
apt-get update -y
apt-get install -y ufw

ufw default deny incoming
ufw default allow outgoing

# Allow SSH before enabling the firewall so the current session is not cut off
ufw allow 22/tcp
ufw allow 443/tcp
ufw allow 80/tcp

ufw --force enable
